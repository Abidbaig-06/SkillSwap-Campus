# MongoDB connection URI (e.g. MongoDB Atlas or local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/skillswap?retryWrites=true&w=majority

# Express session secret (auto-generated in development if missing)
SESSION_SECRET=your-secure-session-secret-here

# Server Port
PORT=3001

# Environment
NODE_ENV=development

