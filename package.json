{
  "name": "skillswap-campus",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -p \"[{name}]\" -n \"backend,frontend\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "vite",
    "dev:backend": "node --watch --watch-path=server server/index.js",
    "start": "node server/index.js",
    "seed:demos": "node server/seed-demos.js",
    "migrate:mongo": "node server/migrate-sqlite-to-mongo.js",
    "test:backend": "node server/test-mongo.js",
    "test:conns": "node server/test-connections-messaging.js",
    "test:sessions": "node server/test-sessions.js",
    "test:msg-reg": "node server/test-messaging-regression.js",
    "test:match": "node server/test-explainable-matching.js",
    "test:photos": "node server/test-profile-photos.js",
    "test:myskills": "node server/test-my-skills.js",
    "test:deletion": "node server/test-account-deletion.js",
    "test": "npm run test:backend && npm run test:conns && npm run test:sessions && npm run test:msg-reg && npm run test:match && npm run test:photos && npm run test:myskills && npm run test:deletion",
    "build": "vite build && node -e \"require('fs').copyFileSync('dist/index.html', 'dist/404.html')\"",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "concurrently": "^10.0.6",
    "connect-mongo": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "lucide-react": "^1.48.0",
    "mongoose": "^9.11.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  }
}
